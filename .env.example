# ---------------------------------------------------------------------------
# BoutiquePro — modèle de configuration
#
# Copier ce fichier en `.env` puis renseigner les valeurs :
#     cp .env.example .env
#
# Toute variable utilisée par l'application doit figurer ici, sans sa valeur.
# ---------------------------------------------------------------------------

# URL de l'API exposée au navigateur. Le préfixe NEXT_PUBLIC_ est obligatoire
# pour qu'une variable soit lisible côté client ; n'y mettre aucun secret.
NEXT_PUBLIC_API_URL=

# Délai au-delà duquel une requête est abandonnée, en millisecondes.
NEXT_PUBLIC_API_TIMEOUT=

# URL utilisée par les Server Components. Identique à la précédente en local,
# elle diffère dès que le front et l'API ne partagent plus le même réseau
# (Docker, Kubernetes) : le serveur joint alors l'API par son nom interne.
API_URL=
