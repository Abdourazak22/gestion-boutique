### Connexion (a lancer en premier)
# @name connexion
POST {{baseUrl}}/api/auth/connexion
Content-Type: application/json

{
  "identifiant": "{{identifiant}}",
  "motDePasse": "{{motDePasse}}"
}

> {% client.global.set("jeton", response.body.jeton); %}

### Produit 1 du jeu d'essai
# @name produitRiz
POST {{baseUrl}}/api/produits
Authorization: Bearer {{jeton}}
Content-Type: application/json

{
  "nom": "Riz parfume 5kg",
  "prixAchat": 4500.00,
  "prixVente": 5500.00,
  "unite": "SACHET",
  "quantiteStock": 20,
  "seuilAlerte": 5
}

> {% client.global.set("rizId", response.body.id); %}

### Produit 2 du jeu d'essai
# @name produitSucre
POST {{baseUrl}}/api/produits
Authorization: Bearer {{jeton}}
Content-Type: application/json

{
  "nom": "Sucre 1kg",
  "prixAchat": 800.00,
  "prixVente": 1000.00,
  "unite": "PAQUET",
  "quantiteStock": 10,
  "seuilAlerte": 2
}

> {% client.global.set("sucreId", response.body.id); %}

### Enregistrer un achat client (plusieurs produits)
# @name achat
POST {{baseUrl}}/api/achats
Authorization: Bearer {{jeton}}
Content-Type: application/json

{
  "nomClient": "Awa Kone",
  "telephoneClient": "0700000000",
  "lignes": [
    { "produitId": {{rizId}}, "quantite": 3 },
    { "produitId": {{sucreId}}, "quantite": 2 }
  ]
}

> {%
    client.global.set("achatId", response.body.id);
    client.test("total = 3 x 5500 + 2 x 1000", function () {
        client.assert(response.body.montantTotal === 18500, "total " + response.body.montantTotal);
    });
%}

### Detail d'un achat (ticket)
GET {{baseUrl}}/api/achats/{{achatId}}
Authorization: Bearer {{jeton}}

### Ticket de caisse en PDF (ouvrir la reponse dans la visionneuse)
GET {{baseUrl}}/api/achats/{{achatId}}/ticket
Authorization: Bearer {{jeton}}

### Historique de tous les achats
GET {{baseUrl}}/api/achats?page=0&size=20
Authorization: Bearer {{jeton}}

### Historique des achats sur une plage de dates
GET {{baseUrl}}/api/achats?du=2026-01-01&au=2026-12-31
Authorization: Bearer {{jeton}}

### Stock insuffisant -> 409, et l'achat entier est annule
POST {{baseUrl}}/api/achats
Authorization: Bearer {{jeton}}
Content-Type: application/json

{
  "lignes": [ { "produitId": {{sucreId}}, "quantite": 9999 } ]
}

### Meme produit deux fois -> 409
POST {{baseUrl}}/api/achats
Authorization: Bearer {{jeton}}
Content-Type: application/json

{
  "lignes": [
    { "produitId": {{rizId}}, "quantite": 1 },
    { "produitId": {{rizId}}, "quantite": 2 }
  ]
}

### Achat sans ligne -> 400
POST {{baseUrl}}/api/achats
Authorization: Bearer {{jeton}}
Content-Type: application/json

{ "nomClient": "Awa", "lignes": [] }

### Enregistrer une livraison grossiste (role GERANT)
# @name livraison
POST {{baseUrl}}/api/livraisons
Authorization: Bearer {{jeton}}
Content-Type: application/json

{
  "nomGrossiste": "Ets Traore",
  "referenceBon": "BL-4421",
  "lignes": [
    { "produitId": {{rizId}}, "quantite": 50, "prixUnitaire": 4300.00 }
  ]
}

> {% client.global.set("livraisonId", response.body.id); %}

### Livraison sans prix unitaire : reprend le prix d'achat du produit
POST {{baseUrl}}/api/livraisons
Authorization: Bearer {{jeton}}
Content-Type: application/json

{
  "nomGrossiste": "Ets Traore",
  "lignes": [ { "produitId": {{sucreId}}, "quantite": 24 } ]
}

### Detail d'une livraison
GET {{baseUrl}}/api/livraisons/{{livraisonId}}
Authorization: Bearer {{jeton}}

### Historique de toutes les livraisons
GET {{baseUrl}}/api/livraisons?page=0&size=20
Authorization: Bearer {{jeton}}

### Plage de dates inversee -> 409
GET {{baseUrl}}/api/livraisons?du=2026-12-31&au=2026-01-01
Authorization: Bearer {{jeton}}

### Verifier le stock apres vente (-3) et livraison (+50)
GET {{baseUrl}}/api/produits/{{rizId}}
Authorization: Bearer {{jeton}}
